APP_NAME="Deal Hay Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_CONNECTION=reverb

# Local: log only. On Render, set MAIL_MAILER=resend and a verified sender.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

ADMIN_USER_CODE=AD-00001
ADMIN_FULL_NAME="Example Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE_NUMBER=0900000000
ADMIN_ADDRESS_DETAIL="1 Example Street"
ADMIN_WARD="Ward 1"
ADMIN_PROVINCE="Ho Chi Minh City"
ADMIN_PASSWORD=ChangeMe123!

R2_DRIVER=local
# Production R2: use a token with Object Read & Write on BOTH buckets.
# R2_DRIVER=s3
# R2_BUCKET=your-public-bucket
# R2_PRIVATE_BUCKET=your-private-chat-bucket
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# CHAT_MEDIA_DISK=r2_private

REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_PORT=8081
REVERB_SCHEME=http
