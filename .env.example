APP_NAME="Deal Hay Backend"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Google Ad Manager rewarded ad unit path (not an AdSense publisher ID).
SHIPPING_REWARDS_ENABLED=false
GOOGLE_AD_MANAGER_REWARDED_AD_UNIT_PATH=
SHIPPING_REWARDS_SESSION_MINUTES=15
SHIPPING_REWARDS_COUPON_DAYS=7

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_CONNECTION=reverb

# Reference addresses are read-only and may be cached independently on each host.
REFERENCE_CACHE_STORE=file
CORS_MAX_AGE=600
# Only for a single API replica; leave unset for shared rate limits across replicas.
# CACHE_LIMITER_STORE=file
# Probes use file cache for one API instance; choose a shared store when scaling.
SPEEDTEST_CACHE_STORE=file
# Raise for shared frontend proxy egress; scoped grant limits remain unchanged.
SPEEDTEST_PROBES_PER_IP_PER_MINUTE=240

# Docker keeps one Laravel Octane worker warm. Keep one on 0.5 CPU / 512 MB.
# OCTANE_WORKERS=1
# MAX_REQUESTS=500
# REQUEST_MAX_EXECUTION_TIME=60
# FrankenPHP >= 1.13: one classic thread + one Octane worker, two threads total.
# FRANKENPHP_NUM_THREADS=1
# FRANKENPHP_MAX_THREADS=2
# QUEUE_SLEEP=3
# REALTIME_QUEUE_SLEEP=0.25
# QUEUE_MEMORY=96
# QUEUE_MEMORY_LIMIT=128M
# QUEUE_MAX_JOBS=500
# QUEUE_MAX_TIME=3600
# SCHEDULER_MEMORY_LIMIT=128M

# Local: log only. On Render, set MAIL_MAILER=resend and a verified sender.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

ADMIN_USER_CODE=AD-00001
ADMIN_FULL_NAME="Example Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE_NUMBER=0900000000
ADMIN_ADDRESS_DETAIL="1 Example Street"
ADMIN_WARD="Ward 1"
ADMIN_PROVINCE="Ho Chi Minh City"
ADMIN_PASSWORD=ChangeMe123!

R2_DRIVER=local
# Production R2: one bucket for product images, avatars, and chat attachments.
# R2_DRIVER=s3
# R2_BUCKET=deal-hay-bucket
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# CHAT_MEDIA_DISK=r2_private

REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_PORT=8081
REVERB_SCHEME=http
